{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    // No script, only ordering: a task that depends on `transit` is re-run when a workspace dependency's files change
    // (packages run each other's TypeScript sources directly, so there is nothing to build first), without waiting
    // for that dependency's own task.
    "transit": {
      "dependsOn": ["^transit"]
    },
    // The AudioWorklet bundle (packages/player/worklet/bleepkit-worklet.js, gitignored): one self-contained file with
    // @bleepkit/core inlined, which the studio loads as `@bleepkit/player/worklet?url`. It is generated, so a clean
    // clone has none. Every task that reads it lists `^build:worklet`, which resolves to the packages this one depends
    // on (only @bleepkit/player has the script), so the studio's dev, build, test and typecheck wait for it and the
    // other packages do not.
    "build:worklet": {
      "dependsOn": ["^transit"],
      "inputs": [
        "src/**",
        "build-worklet.ts",
        "worklet-build-options.ts",
        "tsconfig*.json",
        "package.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": ["worklet/**"]
    },
    "build": {
      "dependsOn": ["^build", "^build:worklet"],
      "inputs": [
        "src/**",
        "build.ts",
        "build-worklet.ts",
        "worklet-build-options.ts",
        "index.html",
        "vite.config.ts",
        "tsconfig*.json",
        "package.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/apps/studio/vite.config.ts"
      ],
      // the player's build also writes the worklet bundle (`build:worklet` is its last step), so a cache hit restores it
      "outputs": ["dist/**", "worklet/**"]
    },
    "typecheck": {
      "dependsOn": ["transit", "^build:worklet"],
      "inputs": [
        "src/**",
        "test/**",
        "build.ts",
        "tsconfig*.json",
        "package.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit", "^build:worklet"],
      "inputs": [
        "src/**",
        "test/**",
        "vitest.config.ts",
        "package.json",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "outputs": []
    },
    // Lint and formatting (Ultracite). Needs no other package's output.
    "check": {
      "inputs": [
        "src/**",
        "test/**",
        "build.ts",
        "index.html",
        "*.ts",
        "*.json",
        "$TURBO_ROOT$/biome.jsonc"
      ],
      "outputs": []
    },
    // Root-level files: configs, scripts and workflows.
    "//#check:root": {
      "inputs": [
        "*.json",
        "*.jsonc",
        ".fallowrc.jsonc",
        "*.ts",
        "scripts/**",
        ".github/**"
      ],
      "outputs": []
    },
    "//#typecheck:root": {
      "inputs": [
        "scripts/**",
        "*.ts",
        "tsconfig*.json",
        "packages/*/vitest.config.ts",
        "apps/*/vitest.config.ts",
        "apps/studio/vite.config.ts"
      ],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build:worklet"],
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
