{
  "name": "@bleepkit/player",
  "version": "0.1.0",
  "description": "Plays Bleepkit audio in a web page, on the Web Audio API and an AudioWorklet.",
  "license": "ISC",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./worklet": "./worklet/bleepkit-worklet.js"
  },
  "files": [
    "dist",
    "worklet"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node build-worklet.ts",
    "build:worklet": "node build-worklet.ts",
    "check": "ultracite check",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node build-worklet.ts",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@bleepkit/core": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./worklet": "./worklet/bleepkit-worklet.js"
    }
  }
}
