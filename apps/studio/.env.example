# Copy to .env.local (gitignored) for `pnpm dev` and `bleepkit studio`. On Vercel set the same names under
# Settings, Environment Variables. Nothing here starts with VITE_, so none of it reaches the browser.

# The Freesound API key for the sample browser. In Freesound's API this is the "Client secret / Api key" of your API
# application (https://freesound.org/apiv2/apply), sent as "Authorization: Token <key>". Without it the Freesound tab
# says it is not configured.
FREESOUND_CLIENT_SECRET=

# The application's client id. Only OAuth2 uses it (downloading original files), and the studio does not, so this is
# optional and ignored.
FREESOUND_CLIENT_ID=

# Answer the Freesound routes from made-up fixtures instead of freesound.org (dev server only): no key, no network.
# FREESOUND_FIXTURES=1
