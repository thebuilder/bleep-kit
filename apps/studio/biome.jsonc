{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "overrides": [
    {
      // Bit twiddling is the point of these two files: CRC-32 and little-endian packing for the zip writer, and the
      // bit-reversal permutation of the FFT. Rewriting them with arithmetic would be slower and harder to check.
      "includes": ["src/zip.ts", "src/visuals/fft.ts"],
      "linter": { "rules": { "suspicious": { "noBitwiseOperators": "off" } } }
    },
    {
      // Per-frame drawing code, the keyboard map and the view builders read top to bottom as one pass over a canvas or a
      // key table; splitting them into helpers that share ten locals would only hide the flow. Everything outside
      // these folders keeps the default limit.
      "includes": [
        "src/visuals/**",
        "src/backdrop/**",
        "src/views/**",
        "src/dev/**",
        "src/ui/piano.ts"
      ],
      "linter": {
        "rules": { "complexity": { "noExcessiveCognitiveComplexity": "off" } }
      }
    },
    {
      // Pixelkit is ejected into src/pixelkit by its CLI and kept as generated: it is still formatted and checked like
      // everything else, but these rules would only produce churn against upstream (bit tricks in its noise and dither
      // code, `i++` loops, method style signatures in its types, long scene functions).
      "includes": ["src/pixelkit/**"],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveCognitiveComplexity": "off" },
          "style": {
            "noIncrementDecrement": "off",
            "useConsistentMethodSignatures": "off"
          },
          "suspicious": { "noBitwiseOperators": "off" }
        }
      }
    }
  ]
}
