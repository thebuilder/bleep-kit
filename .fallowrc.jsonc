{
  "$schema": "./node_modules/fallow/schema.json",
  // docs/ is prose, not code. apps/studio/src/pixelkit/ is Pixelkit's ejected code: vendored, managed by Pixelkit's own
  // CLI (`pixelkit diff` shows how it differs from upstream), so its unused exports, complexity and clones are
  // upstream's to fix and editing them here would only make the next diff noisy. The studio's own code that imports it
  // (src/backdrop) is still analyzed. examples/ holds project folders whose export/ files (audio.ts) are generated by
  // `bleepkit export` for a game to import; nothing in this repo imports them.
  "ignorePatterns": ["docs/**", "apps/studio/src/pixelkit/**", "examples/**"],
  // Class members are reached through typed arrays and fields (`this.channelList[i]?.tick(frame)`, `bus.process(n)`).
  // The syntactic pass cannot see through those and calls the methods unused, so Fallow reads the packages' types.
  "typeAware": {
    "enabled": true,
    "projects": [
      "packages/core/tsconfig.json",
      "packages/sfx/tsconfig.json",
      "packages/player/tsconfig.json",
      "packages/cli/tsconfig.json",
      "apps/studio/tsconfig.json"
    ]
  },
  "rules": {
    // The semantic pass above also reports an exported signature that names a type its module does not export (a
    // helper's `Frequency = Sfx["frequency"]` alias, a test fake's node type). tsc already checks every signature, and
    // only the packages' entry points are public API, so a module-private name in an internal signature is no leak.
    "private-type-leak": "off"
  },
  "ignoreExports": [
    {
      // Every chip module exposes the same tuning functions for its own hardware (a period register, a noise table,
      // pulse widths), and the voice imports them by chip with an alias. Same names, different silicon.
      "file": "packages/core/src/chips/*.ts",
      "exports": [
        "hzToPeriod",
        "periodToHz",
        "quantizeHz",
        "quantizeNoiseRate",
        "quantizePulseHz"
      ]
    }
  ],
  "duplicates": {
    // Tests restate the oracle on purpose: a Hann window or a zip writer in a helper is a second, independent
    // implementation, and sharing it with the code under test would make the test agree with the bug.
    "ignore": ["**/test/**"]
  },
  // Coverage for exact CRAP scores is passed on the command line: `pnpm fallow` runs the tests first, CI passes the
  // coverage it just wrote. Without coverage, Fallow estimates the scores.
  "health": {
    // The same ceiling as Biome's noExcessiveCognitiveComplexity in the Ultracite preset, so one standard applies.
    "maxCognitive": 20,
    // Test files are not production code: their complexity and coverage say nothing about risk.
    "ignore": ["**/test/**"],
    // The per-sample audio path. Each of these is one pass over the signal: a loop that runs 48000 times a second per
    // voice, where the branches are the signal flow (which chip's mixer, which stage of an envelope, which filter
    // mode). Splitting them into a helper per branch hides that flow and adds call overhead to the hottest code in the
    // engine, so Biome's complexity rule is off for these directories too. The ceilings sit just above today's values,
    // so these functions cannot grow, and the golden hashes pin what they compute. Fully tested code scores a CRAP
    // equal to its cyclomatic complexity, which is why the engine entries allow 45.
    "thresholdOverrides": [
      {
        "files": ["packages/core/src/dsp/**"],
        "functions": [
          "colorChannel",
          "process",
          "opStep",
          "renderNoise",
          "side",
          "renderSidGroup"
        ],
        "maxCognitive": 52,
        "maxCyclomatic": 26,
        "reason": "Per-sample DSP loops: chip coloring, FM operators, the limiter, LFSR noise, the reverb comb filters and the SID voice group."
      },
      {
        "files": ["packages/core/src/engine/voice.ts"],
        "functions": ["mixTo", "renderChunk", "amplitude", "sfxEnvelope"],
        "maxCognitive": 69,
        "maxCrap": 45,
        "maxCyclomatic": 41,
        "reason": "A voice's per-sample mixing, source rendering, amplitude stage and sfx envelope."
      },
      // The studio's canvas drawing. Each of these paints one picture in one pass (the pixels of the backdrop, the
      // columns of a waveform, the bars of a spectrum), where the branches are the picture's parts: which layer, which
      // channel, which half of the range. Splitting them into a helper per branch would scatter a drawing across
      // functions that only make sense together and add a call to a loop that runs per pixel. The ceilings sit just
      // above today's values so they cannot grow.
      {
        "files": ["apps/studio/src/backdrop/reactive.ts"],
        "functions": ["render"],
        "maxCognitive": 46,
        "maxCrap": 45,
        "maxCyclomatic": 26,
        "reason": "The reactive backdrop layer: the pulse glow, the rings, the sparkle bursts and the lightning, each a loop over pixels of one frame."
      },
      {
        "files": ["apps/studio/src/visuals/waveform.ts"],
        "functions": ["drawWaveform"],
        "maxCognitive": 38,
        "maxCyclomatic": 28,
        "reason": "The waveform picture: the grid, the peaks, the playhead, the loop markers and the time axis."
      },
      {
        "files": ["apps/studio/src/visuals/strip.ts"],
        "functions": ["drawSpectrum"],
        "maxCognitive": 30,
        "reason": "The spectrum strip: one pass over the bars, each with its level from the FFT bins, its fall and peak hold, and its lit segments."
      }
    ]
  }
}
